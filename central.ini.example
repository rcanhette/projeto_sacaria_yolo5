[server]
host=0.0.0.0
port=8080
threads=16
backlog=2048
connection_limit=200
channel_timeout=90

[database]
# type=postgres | sqlite
type=postgres
host=localhost
port=5432
database=contagem_sacaria
user=postgres
password=postgres
# Para SQLite (quando type=sqlite)
sqlite_path=data/app.db

[paths]
# Diretório de logs do serviço (será criado se não existir)
logs_dir=logs
# Opcional: caminhos explícitos
# waitress_exe=C:\\workspace\\python\\projeto_sacaria_yolo5\\venv\\Scripts\\waitress-serve.exe
# python_exe=C:\\workspace\\python\\projeto_sacaria_yolo5\\venv\\Scripts\\python.exe

[env]
# Variáveis adicionais aplicadas ao processo do serviço
APP_HOST=0.0.0.0
APP_PORT=8080
