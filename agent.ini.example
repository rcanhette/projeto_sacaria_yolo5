[agent]
# Identificador amigável do agente (livre)
id=pc1-ct1
# ID da TC no servidor central
tc_id=1
# URL do servidor central acessível a partir deste PC
central_url=http://localhost:8080
# Token opcional (autenticação desativada por padrão)
token=
# TLS do Central (quando usar HTTPS em central_url)
central_verify=true
# Opcional: caminho para CA/servidor em PEM para validar o certificado
central_ca=
