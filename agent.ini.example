[agent]
# Identificador amigavel do agente (livre)
id=pc1-ct1
# ID da TC no servidor central
tc_id=1
# URL do servidor central acessivel a partir deste PC
central_url=http://localhost:8080
# Token opcional (autenticacao desativada por padrao)
token=
# TLS do Central (quando usar HTTPS em central_url)
central_verify=true
# Opcional: caminho para CA/servidor em PEM para validar o certificado
central_ca=

port=9090

