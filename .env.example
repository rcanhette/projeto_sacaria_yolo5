# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente.

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=contagem_sacaria
PGUSER=postgres
PGPASSWORD=postgres

# Alternar banco
# DB_TYPE=postgres | sqlite
# SQLITE_PATH=data/app.db

# Opcional: host/porta do servidor web
APP_HOST=0.0.0.0
APP_PORT=8080

# Observação: o Agente lê central_url, tc_id e id do arquivo
# windows_service.ini (seção [agent]). Ajuste lá.
